          return (T) new ChatRepository(singletonCImpl.provideApiServiceProvider.get(), singletonCImpl.networkUtilsProvider.get());

          case 18: // com.example.gestionturnosapp.data.repository.HealthRepository 
          return (T) new HealthRepository(singletonCImpl.healthRecordDao(), singletonCImpl.symptomDao());

          case 19: // com.example.gestionturnosapp.data.repository.EspecialidadRepository 
          return (T) new EspecialidadRepository();

          case 20: // com.example.gestionturnosapp.data.repository.EstudioRepository 
          return (T) new EstudioRepository(singletonCImpl.provideApiServiceProvider.get(), singletonCImpl.offlineCacheManagerProvider.get(), singletonCImpl.networkUtilsProvider.get());

          default: throw new AssertionError(id);
        }
      }
    }
  }
}
