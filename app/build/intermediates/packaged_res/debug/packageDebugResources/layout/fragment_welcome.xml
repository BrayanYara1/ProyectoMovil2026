<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_modern">

    <View
        android:id="@+id/welcomeBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_main_gradient"
        app:layout_constraintHeight_percent="0.75"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_header_curved"
        app:layout_constraintBottom_toBottomOf="@id/welcomeBg" />

    <!-- Decorative elements -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_glass_pill"
        android:alpha="0.08"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content group moved up to avoid the curve -->
    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutAuthButtons"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logoContainer"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="44dp"
            app:cardElevation="24dp"
            app:strokeWidth="5dp"
            app:strokeColor="@color/white">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="32dp"
                android:src="@drawable/ic_medical_logo"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="SaludActiva"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tu bienestar es nuestra misión.\nGestiona tu salud de forma profesional."
            android:textAlignment="center"
            android:textColor="#F2FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAuthButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginWelcome"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_login"
            android:fontFamily="sans-serif-black"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:stateListAnimator="@animator/scale_button_press"
            app:cornerRadius="24dp"
            app:elevation="8dp"
            android:backgroundTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterWelcome"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="@string/register_title"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-black"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:stateListAnimator="@animator/scale_button_press"
            app:cornerRadius="24dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/primary_container" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
